<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Prevent direct access to sensitive files and folders
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/(.*)?$ - [F,L,NC]

    # Rewrite all requests into the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
